              "value": "={{ ((($('Configuration').item.json.campaign_subject_prefix || '').toString().trim()) ? ($('Configuration').item.json.campaign_subject_prefix.toString().trim() + ' ') : '') + ((($('Read Leads').item.json.subject_override || '').toString().trim()) || ((($json.output || '').match(/(?:\\*\\*)?\\s*Subject\\s*:\\s*(.+)/i) || [null, ''])[1] || '').replace(/\\*\\*/g, '').trim() || ('Automation opportunity for ' + $('Read Leads').item.json.company)) }}",
