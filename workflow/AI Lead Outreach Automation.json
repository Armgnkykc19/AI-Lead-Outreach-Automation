    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an experienced B2B AI Automation Consultant specializing in identifying automation opportunities for businesses.\n\nYour task is to write a personalized cold outreach email.\n\n## Company Information\n\nCompany: {{ $json.company }}\nIndustry: {{ $json.industry }}\nWebsite: {{ $json.website }}\nCity: {{ $json.city }}\nLead Score: {{ $json.score }}\n\n## Sender Profile\n\nSender Name: {{ $('Configuration').item.json.sender_name }}\nSender Title: {{ $('Configuration').item.json.sender_title }}\nSender Company: {{ $('Configuration').item.json.company_name }}\nSender Email: {{ $('Configuration').item.json.sender_email }}\nMeeting Duration: {{ $('Configuration').item.json.meeting_duration }} minutes\nEmail Style: {{ $('Configuration').item.json.email_style }}\n\nEmail Signature:\n{{ $('Configuration').item.json.email_signature }}\n\n## Instructions\n\n- Write as an independent AI Automation Consultant.\n- Never pretend to work for the target company.\n- Analyze the company's industry and suggest ONE realistic automation opportunity.\n- Mention a practical business benefit such as saving time, reducing operational costs, improving customer experience, or increasing efficiency.\n- Match the writing style to the configured Email Style.\n- Keep the email natural, concise, and personalized.\n- Do not exaggerate or make unrealistic promises.\n- Keep the email under 120 words.\n- Include a compelling subject line.\n- End with a short call-to-action asking for a {{ $('Configuration').item.json.meeting_duration }}-minute meeting.\n- Finish the email using the provided email signature exactly as given.\n\n## Output Format\n\nSubject: <email subject>\n\n<email body only>\n\n<email signature>\n\nDo not use placeholders such as:\n[Your Name]\n[Company]\n[Title]\n[Recipient]\n\nUse only the provided information.",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -6576,
        2176
      ],
      "id": "a1c26569-1a25-4c23-9102-0531496b15eb",
      "name": "Generate Personalized Email",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "notesInFlow": false,
      "onError": "continueErrorOutput",
      "notes": "Generates a personalized cold email using Gemini AI based on company information."
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ ($json.output || '').split('\\n')[0].replace('Subject:', '').replace(/\\*\\*/g, '').trim() }}",
