    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a B2B AI Automation Consultant.\n\nYour task is to write a personalized cold outreach email to the target company.\n\nCompany: {{ $json.company }}\nIndustry: {{ $json.industry }}\nWebsite: {{ $json.website }}\nCity: {{ $json.city }}\nLead Score: {{ $json.score }}\n\nRequirements:\n- Write as an external consultant.\n- Do NOT pretend to work for the company.\n- Suggest one realistic automation opportunity based on the company's industry.\n- Keep the email under 120 words.\n- Include a subject line.\n- Keep the tone professional and concise.\n- End with a clear call-to-action.\n\nUse the following sender information:\n\nName: Armagan Kayikci\nTitle: Computer Engineering Student & AI Automation Developer\n\nDo not use placeholders such as:\n[Your Name]\n[Your Company]\n[Your Title]\n[Contact Name]\n\nUse the sender information directly.",
        "options": {}
      },
